clear all;
close all;

%=================[ Initialisation des parametres ]========================

Fe = 24000;
Te = 1 / Fe;
Rb = 3000;
Tb = 1 / Rb;
Nbits = 10000;
Fp = 2000;
rolloff = 0.35;
L = 10;
Ts = 2*Tb;
Ns = Ts/Te;
retard = L*Ns+1;

%===[ Implantation de la transmission avec transposition de fréquence ]====

% Génération des données à transmettre
bits = randi([0 1], 1, Nbits); 

% Mapping QPSK
SI = 1 - 2*bits(1:2:Nbits);
SQ = 1 - 2*bits(2:2:Nbits);
qpsk_symbols = SI + 1i*SQ;

% Affichage des symboles QPSK
figure(1);
scatter(real(qpsk_symbols), imag(qpsk_symbols));
xlabel('Partie réelle');
ylabel('Partie imaginaire');
title('Symboles QPSK');

% Filtre de mise en forme en racine de cosinus surélevé
h = rcosdesign(rolloff, L, Ns);

% Construction du peigne de dirack
peigneDirack = kron(qpsk_symbols, [1 zeros(1,Ns - 1)]);

xe = filter(h, 1, [peigneDirack zeros(1, retard)]);

% Densité spéctrale de puissance des signaux générés sur les voies en phase
% et en quadrature
Si = pwelch(real(xe),[], [], 2048, Fe, 'twosided');
Sq = pwelch(imag(xe),[], [], 2048, Fe, 'twosided');

% Affichage des DSP
f = linspace(-Fe/2, Fe/2, 2048);
%{
figure(2);
semilogy(f, fftshift(Si));
hold on;
semilogy(f, fftshift(Sq));
xlabel("Fréquence");
ylabel("Amplitude");
legend('Voie en phase (I)', 'Voie en quadrature (Q)');
%}
% Transposition de fréquence
t = 0:Te:Te*(length(xe)-1);
expo = exp(2*1i*pi*Fp*t);
x = real(xe.*expo);

% Ajout du bruit
Eb_Sur_N0 = 2;
Px = mean(abs(x).^2);
M = 4;
sigma_n = Px * Ns / ( 2*log2(M)*(10).^Eb_Sur_N0);
bruit = sigma_n * randn(1, length(x));
x = x + bruit;

% Densité spéctrale de puissance du signal transmis sur fréquence porteuse
Sx = pwelch(x,[], [], 2048, Fe, 'twosided');
figure(3);
semilogy(f, fftshift(Sx));
xlabel("Fréquence");
ylabel("Amplitude");

figure(4);
plot(t, x);
xlabel("Temps");
ylabel("Amplitude");

% Démodulation
x = x.*conj(expo);
z = filter(h, 1, [x zeros(1, L*Ns/2)]);
z = z(L*Ns/2 + 1:end);

z = z(1 : Ns: 1 + Ns*Nbits/2-1);
s_retrouve = zeros(1, Nbits);
s_retrouve(1:2:end) = (real(z) < 0);
s_retrouve(2:2:end) = (imag(z) < 0);

% TEB expérimental
x = real(xe.*expo);
EbN0_db = [0: 6];
EbN0 = 10.^(EbN0_db./10);
Px = mean(abs(xe).^2);
for k = 1:length(EbN0)
    sigma_n = sqrt(Px * Ns / ( 4*log2(M)*EbN0(k)));
    bruit = sigma_n * randn(1, length(x));
    r = x + bruit;
    % Démodulation
    re= r.*conj(expo);
    z = filter(h, 1, re);
    ze = z(retard + 1: Ns: end);
    
    s_retrouve = zeros(1, Nbits);
    s_retrouve(1:2:end) = (real(ze) < 0);
    s_retrouve(2:2:end) = (imag(ze) < 0);
    
    TEB_exp1(k) = sum(bits ~= s_retrouve)/Nbits;
end
%teb théorique 
Eb_Sur_N0_db = linspace(0,6,8*2+1);
Eb_Sur_N0 = 10.^(Eb_Sur_N0_db/10);

TEB_th = qfunc(sqrt(2*Eb_Sur_N0));

figure(5);
semilogy(EbN0_db, TEB_exp1, '+');
hold on;
semilogy(Eb_Sur_N0_db, TEB_th);
title('Comparaison erreur binaire pour QPSK');
xlabel('E_b/N_0 (en dB)');
ylabel('TEB');

%=========[ Implantation de chaine passe-bas équivalente 
%           à la chaine de transmission sur porteuse ]=====================

Eb_Sur_N0_db = [0: 6];
EbN0 = 10.^(Eb_Sur_N0_db./10);
Nbits = 3000;
Fe = 24000;
Te = 1 / Fe;
Rb = 3000;
M = 4;
Rs = Rb/log2(M);
Ns = Fe/Rs;
Fp = 2000;
rolloff = 0.35;
L = 10;
retard = L*Ns+1;

% Génération des données à transmettre
bits = randi([0 1], 1, Nbits); 

% Mapping QPSK
SI = 1 - 2*bits(1:2:Nbits);
SQ = 1 - 2*bits(2:2:Nbits);
qpsk_symbols = SI + 1i*SQ;

% Filtre de mise en forme en racine de cosinus surélevé
h = rcosdesign(rolloff, L, Ns);

% Construction du peigne de dirack
peigneDirack = kron(qpsk_symbols, [1 zeros(1,Ns - 1)]);
xe = filter(h, 1, [peigneDirack zeros(1, retard)]);

t = [0:length(xe)-1]*Te;
plot(t, real(xe), 'r');
hold on;
plot(t, imag(xe));
legend("")
% Transposition de fréquence
t = [0:length(xe)-1]*Te;
expo = exp(2*1i*pi*Fp*t);
x = real(xe.*expo);

% Densité spéctrale de puissance des signaux générés sur les voies en phase
% et en quadrature
Si = pwelch(real(x),[], [], 2048, Fe, 'twosided');
Sq = pwelch(imag(x),[], [], 2048, Fe, 'twosided');

% Affichage des DSP
f = linspace(-Fe/2, Fe/2, 2048);
%{
figure(2);
semilogy(f, fftshift(Si));
hold on;
semilogy(f, fftshift(Sq));
xlabel("Fréquence");
ylabel("Amplitude");
legend('Voie en phase (I)', 'Voie en quadrature (Q)');
%}

% Ajout du bruit
Px = mean(abs(xe).^2);
for k = 1:length(EbN0)
    sigma_n = Px * Ns / ( 2*log2(M)*EbN0(k));
    
    % Ajout du bruit complexe
    I = sqrt(sigma_n)/2 * randn(1, length(x));
    Q = sqrt(sigma_n)/2 * randn(1, length(x));
    r = x + I+ 1i*Q;
    % Démodulation
    re= r.*conj(expo);
    z = filter(h, 1, re);

    if (k == 1)
        %{%}
        Si = pwelch(real(z),[], [], 2048, Fe, 'twosided');
        Sq = pwelch(imag(z),[], [], 2048, Fe, 'twosided');
        f = linspace(-Fe/2, Fe/2, 2048);
        figure(2)
        semilogy(f, fftshift(Si));
        hold on;
        semilogy(f, fftshift(Sq));
        xlabel("Fréquence");
        ylabel("Amplitude");
        legend('Voie en phase (I)', 'Voie en quadrature (Q)');
        %}

    end 
    ze = z(retard + 1: Ns: length(z));
    scatterplot(ze(1 :Ns : end));
    s_retrouve = zeros(1, Nbits);
    s_retrouve(1:2:end) = (real(ze) < 0);
    s_retrouve(2:2:end) = (imag(ze) < 0);
    
    TEB_exp2(k) = sum(bits ~= s_retrouve)/Nbits;
end
figure(7)


%figure(8)
%eyediagram(z(2*Ns+1:end),2*Ns,2*Ts,Ns-1);

Eb_Sur_N0 = 10.^(Eb_Sur_N0_db/10);
TEB_theo2=  qfunc(sqrt(2*Eb_Sur_N0));  

%tracés des TEB
figure(9);
semilogy(Eb_Sur_N0_db,TEB_theo2);
hold on;
semilogy(Eb_Sur_N0_db,TEB_exp2,'+');
title('Comparaison erreur binaire pour QPSK');
xlabel('E_b/N_0 (en dB)');
ylabel('TEB');

%%=================[Comparaison DVS-S et DVB-S2]============================
Nbits = 3000;
Fe = 6e3;
Rb = 3e3;
Ns = Fe/Rb;
retard = L*Ns+1;

% Génération des données à transmettre
bits = randi([0 1], 1, Nbits);

%Mapping 8-PSK
V_bits = bit2int(bits',3);
V_bits = V_bits';
%4*bits(1:3:end)+ 2*bits(2:3:end) + bits(3:3:end);
psk_symbols = pskmod(V_bits, 8);

% Affichage des symboles 8-PSK
figure(10)
scatterplot(psk_symbols);
xlabel('Partie réelle');
ylabel('Partie imaginaire');
title('Symboles 8-PSK');

% Filtre de mise en forme en racine de cosinus surélevé
h = rcosdesign(rolloff, L, Ns);

% Construction du peigne de dirack
peigneDirack = kron(psk_symbols, [1 zeros(1,Ns - 1)]);
xe = filter(h, 1, [peigneDirack zeros(1, retard)]);


% Ajout du bruit
Eb_Sur_N0 = 2;
Px = mean(abs(x).^2, 2);
M = 8;
sigma_n = Px * Ns / ( 2*log2(M)*Eb_Sur_N0);
bruit = sigma_n * randn(1, length(xe));
x = xe + bruit;

% Demaping
x_retrouve = filter(h, 1, x);


x_retrouve = x_retrouve(retard + 1 : Ns : end);
bits_retrouve = pskdemod(x_retrouve, 8);
bits_retrouve = int2bit(bits_retrouve,3);
bits_retrouve = bits_retrouve(:)';

% Densité spéctrale de puissance des signaux générés sur les voies en phase
% et en quadrature
Si = pwelch(real(x),[], [], 2048, Fe, 'twosided');
Sq = pwelch(imag(x),[], [], 2048, Fe, 'twosided');

% Affichage des DSP
f = linspace(-Fe/2, Fe/2, 2048);
figure(12);
semilogy(f, fftshift(Si));
hold on;
semilogy(f, fftshift(Sq));
xlabel("Fréquence");
ylabel("Amplitude");
legend('Voie en phase (I)', 'Voie en quadrature (Q)');

Eb_Sur_N0_db = [0: 6];
EbN0 = 10.^(Eb_Sur_N0_db./10);

% Ajout du bruit
Px = mean(abs(xe).^2);
for k = 1:length(EbN0)
    sigma_n = Px * Ns / ( 2*log2(M)*EbN0(k));
    
    % Ajout du bruit complexe
    I = sqrt(sigma_n)/2 * randn(1, length(xe));
    Q = sqrt(sigma_n)/2 * randn(1, length(xe));
    r = xe + I+ 1i*Q;
    % Demaping
    z = filter(h, 1, r);
    ze = z(retard + 1: Ns: length(z)-1);
    s_retrouve = pskdemod(ze', 8);
    s_retrouve = int2bit(s_retrouve,3);
    s_retrouve = s_retrouve(:)';
    
    TEB_exp3(k) = sum(bits ~= s_retrouve)/Nbits;
end


TEB_th = (1/3) * qfunc(sqrt(1.1*Eb_Sur_N0));

figure(13);
semilogy(Eb_Sur_N0_db, TEB_exp3, '+');
hold on;
semilogy(Eb_Sur_N0_db, TEB_th);
title('Comparaison erreur binaire pour 8-PSK');
xlabel('E_b/N_0 (en dB)');
ylabel('TEB');





