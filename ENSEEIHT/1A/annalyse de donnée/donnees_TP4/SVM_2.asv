function [X_VS,w,c,code_retour] = SVM_2(X,Y)
%UNTITLED Summary of this function goes here
%   Detailed explanation goes here

eps = 1e-6;
f = ones(1, size(Y, 1));
H = (Y.* X)*(Y.*X)';
Aeq = Y;
Beq = zeros(size(Y, 1), 1);
lb = zeros(size(Y, 1),1);

[wt, ~, code_retour] = quadprog(H, f, [], [], Aeq, Beq,lb, []);
c = wt(3);
w = wt(1:2); 
X_VS = X(abs(A*wt - B) < eps, :);


end

